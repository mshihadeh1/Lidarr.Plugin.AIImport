<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Lidarr.Plugin.AIImport</AssemblyName>
    <RootNamespace>Lidarr.Plugin.AIImport</RootNamespace>
    <PluginVersion Condition="'$(PluginVersion)' == ''">1.3.0</PluginVersion>
    <PluginAssemblyVersion Condition="'$(PluginAssemblyVersion)' == ''">1.3.0.0</PluginAssemblyVersion>
    <Version>$(PluginVersion)</Version>
    <AssemblyVersion>$(PluginAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(PluginAssemblyVersion)</FileVersion>
    <InformationalVersion>$(PluginVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NativeHelperSha256" Value="$(NativeHelperSha256)" />
    <InternalsVisibleTo Include="Lidarr.Plugin.AIImport.Tests" />
    <ProjectReference Include="../../vendor/Lidarr/src/NzbDrone.Common/Lidarr.Common.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <AdditionalProperties>EnableAnalyzers=false;AssemblyVersion=3.1.2.4913</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../../vendor/Lidarr/src/NzbDrone.Core/Lidarr.Core.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <AdditionalProperties>EnableAnalyzers=false;AssemblyVersion=3.1.2.4913</AdditionalProperties>
    </ProjectReference>
    <ProjectReference Include="../../vendor/Lidarr/src/Lidarr.Http/Lidarr.Http.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <AdditionalProperties>EnableAnalyzers=false;AssemblyVersion=3.1.2.4913</AdditionalProperties>
    </ProjectReference>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <EmbeddedResource Include="Ui/ai-import.html" LogicalName="Lidarr.Plugin.AIImport.Ui.ai-import.html" />
  </ItemGroup>
</Project>
